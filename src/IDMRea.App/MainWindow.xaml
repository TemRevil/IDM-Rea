<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IDMRea.App.MainWindow" Title="IDM-Rea">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked"/>
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="IDM-Rea" IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleIcon"/>
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search downloads" AutomationProperties.Name="Search downloads"
                                QueryIcon="Find" MinWidth="280" MaxWidth="440" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="244" CompactModeThresholdWidth="760" ExpandedModeThresholdWidth="1000"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All downloads" Tag="all" AutomationProperties.Name="All downloads" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloading" Tag="downloading" AutomationProperties.Name="Downloading">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queued and paused" Tag="queued" AutomationProperties.Name="Queued and paused">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Completed" Tag="completed" AutomationProperties.Name="Completed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Failed" Tag="failed" AutomationProperties.Name="Failed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE783;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Categories"/>
                <NavigationViewItem Content="Video" Tag="Video" AutomationProperties.Name="Video">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Music" Tag="Music" AutomationProperties.Name="Music">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Documents" Tag="Documents" AutomationProperties.Name="Documents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Programs" Tag="Programs" AutomationProperties.Name="Programs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7AC;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Archives" Tag="Archives" AutomationProperties.Name="Archives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF012;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Images" Tag="Images" AutomationProperties.Name="Images">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other" Tag="Other" AutomationProperties.Name="Other">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" AutomationProperties.Name="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <Grid Grid.Row="2" Padding="16,6" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="EngineText" Text="Connecting to engine" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
