<Window x:Class="IDMRea.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IDM-Rea">
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="36" RowSpacing="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="IDM-REA" CharacterSpacing="200" Foreground="#75DECE"/><TextBlock Text="Your downloads, in motion." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Add a link. Pause when you need to. Pick up where you left off." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Border Grid.Row="1" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24">
   <StackPanel Spacing="12"><TextBlock Text="New download" FontSize="20" FontWeight="SemiBold"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UrlBox" PlaceholderText="https://example.com/file.zip" AutomationProperties.Name="Download URL"/><Button x:Name="AddButton" Grid.Column="1" Content="Start download" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"/></Grid><TextBox x:Name="FolderBox" Header="Save to"/><Button Content="Open downloads" Click="Open_Click"/></StackPanel>
  </Border>
  <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" IsClosable="True"/>
  <Grid Grid.Row="3"><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="A clear queue. A fresh start." FontSize="24"/><TextBlock Text="Paste a download link above to get going."/></StackPanel><ListView x:Name="JobsList" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid Padding="12" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Pause" Tag="{Binding Id}" Click="Pause_Click"/><Button Content="Resume" Tag="{Binding Id}" Click="Resume_Click"/><Button Content="Cancel" Tag="{Binding Id}" Click="Cancel_Click"/></StackPanel></Grid><ProgressBar Grid.Row="1" Value="{Binding Progress}" Maximum="100"/><TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="#FFB4AB" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
  <Button Grid.Row="4" x:Name="StopButton" Content="Pause all and stop engine" Click="Stop_Click"/>
 </Grid>
</Window>
