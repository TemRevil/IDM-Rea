<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IDMRea.App.Views.DetailsPane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:IDMRea.App.Views" AutomationProperties.Name="Download details">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
    </UserControl.Resources>
    <Grid Width="360" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Padding="20,16,12,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="KindIcon" FontSize="20" VerticalAlignment="Top" Margin="0,3,4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Top" Padding="8" AutomationProperties.Name="Close details"
                    ToolTipService.ToolTip="Close details" Click="Close_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
            <StackPanel Spacing="18">
                <StackPanel Spacing="8">
                    <views:PartsMap x:Name="Parts"/>
                    <TextBlock x:Name="PartsText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <InfoBar x:Name="ErrorInfo" Severity="Error" IsClosable="False" IsOpen="False"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Content="Open" AutomationProperties.Name="Open" Click="Action_Click" Tag="open"/>
                    <Button x:Name="ToggleButton" Click="Action_Click" Tag="toggle">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ToggleIcon" FontSize="14"/>
                            <TextBlock x:Name="ToggleText"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RetryButton" Content="Retry" AutomationProperties.Name="Retry" Click="Action_Click" Tag="retry"/>
                </StackPanel>

                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="SizeText" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="1" Text="Downloaded" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="ReceivedText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="2" Text="Speed" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="SpeedText" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="3" Text="Time left" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="LeftText" Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="4" Text="Can resume" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="ResumableText" Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="5" Text="Added" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="AddedText" Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="6" Text="Finished" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="FinishedText" Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="7" Text="Attempts" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="AttemptsText" Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldValue}"/>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Link" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="UrlText" Style="{StaticResource FieldValue}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                    <Button Content="Copy link" AutomationProperties.Name="Copy link" Click="Action_Click" Tag="copy"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Saved to" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="PathText" Style="{StaticResource FieldValue}" FontFamily="Consolas" FontSize="12"/>
                    <Button Content="Show in folder" AutomationProperties.Name="Show in folder" Click="Action_Click" Tag="folder"/>
                </StackPanel>

                <StackPanel Spacing="8" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Button x:Name="CancelButton" Content="Cancel download" AutomationProperties.Name="Cancel download" HorizontalAlignment="Stretch" Click="Action_Click" Tag="cancel" Margin="0,8,0,0"/>
                    <Button Content="Remove from list" AutomationProperties.Name="Remove from list" HorizontalAlignment="Stretch" Click="Action_Click" Tag="remove"/>
                    <Button x:Name="DeleteButton" Content="Delete file" AutomationProperties.Name="Delete file" HorizontalAlignment="Stretch" Click="Action_Click" Tag="delete"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
