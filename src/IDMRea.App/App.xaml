<Application x:Class="IDMRea.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#C46532</Color>
                    <Color x:Key="SystemAccentColorDark1">#A8552A</Color>
                    <Color x:Key="SystemAccentColorDark2">#8C4623</Color>
                    <Color x:Key="SystemAccentColorDark3">#6F371B</Color>
                    <Color x:Key="SystemAccentColorLight1">#D07C4F</Color>
                    <Color x:Key="SystemAccentColorLight2">#DC946C</Color>
                    <Color x:Key="SystemAccentColorLight3">#E8AE8E</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#C46532</Color>
                    <Color x:Key="SystemAccentColorDark1">#A8552A</Color>
                    <Color x:Key="SystemAccentColorDark2">#8C4623</Color>
                    <Color x:Key="SystemAccentColorDark3">#6F371B</Color>
                    <Color x:Key="SystemAccentColorLight1">#D07C4F</Color>
                    <Color x:Key="SystemAccentColorLight2">#DC946C</Color>
                    <Color x:Key="SystemAccentColorLight3">#E8AE8E</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
